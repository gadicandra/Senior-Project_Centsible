# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Database
DATABASE_URL=
DIRECT_URL=

# AI (Fase 1) — kosongkan AI_TEXT_PROVIDER untuk mematikan AI (form manual tetap jalan)
AI_TEXT_PROVIDER=                    # anthropic | openai-compatible | azure (azure belum diimplementasikan)
# AI_TEXT_MODEL harus model yang TIDAK "thinking" saat parameter thinking tidak dikirim (mis. claude-haiku-4-5).
# Model thinking-default menghabiskan max_tokens sehingga semua parse jatuh ke form manual (log: stop_reason=max_tokens).
AI_TEXT_MODEL=                       # mis. claude-haiku-4-5
ANTHROPIC_API_KEY=                   # rahasia, hanya untuk anthropic
AI_TEXT_BASE_URL=                    # hanya openai-compatible, mis. http://localhost:20128/v1
AI_TEXT_API_KEY=                     # rahasia, hanya openai-compatible
AI_PARSE_DAILY_LIMIT=100
AI_DRAFT_SECRET=                     # rahasia, openssl rand -hex 32
# AI_STT_ENABLED=false
# AI_STT_BASE_URL=http://localhost:8000/v1
# AI_STT_MODEL=Systran/faster-whisper-small

# Cron
# CRON_SECRET=                          # openssl rand -hex 32
