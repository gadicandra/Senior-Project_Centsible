# Salin ke .env.local lalu isi:  cp .env.example .env.local
# .env.local tidak di-commit (.gitignore: .env*). Lihat docs/arsitektur.md §9.4.

# --- Supabase: Dashboard → Project Settings → API Keys ---------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Kunci publishable (sb_publishable_...) — aman di browser, dilindungi RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Kunci secret (sb_secret_...) — HANYA server: hapus akun & uji `pnpm test:db`.
SUPABASE_SECRET_KEY=

# --- Database: Dashboard → tombol "Connect" ---------------------------------
# Runtime Prisma Client: Transaction pooler, port 6543.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Prisma CLI (`pnpm db:deploy`): Session pooler atau Direct connection, port 5432.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- AI (Fase 1) — belum dipakai kode sampai Subproyek F --------------------
# AI_TEXT_PROVIDER=anthropic            # anthropic | openai-compatible | azure
# AI_TEXT_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=
# AI_TEXT_BASE_URL=http://localhost:20128/v1   # hanya openai-compatible (9router)
# AI_TEXT_API_KEY=
# AI_STT_ENABLED=false
# AI_STT_BASE_URL=http://localhost:8000/v1
# AI_STT_MODEL=Systran/faster-whisper-small

# --- Cron (Fase 1, Vercel Cron) ---------------------------------------------
# CRON_SECRET=                          # openssl rand -hex 32
